% Generic helper macros for the HUST undergraduate thesis template.
% Project-specific symbols should be added below in your own thesis branch.

\usepackage{amsmath,amssymb}
\usepackage{graphicx}
\usepackage{etoolbox}

\newlength{\originalparindent}
\setlength{\originalparindent}{\parindent}

% Keep table body at Wuhao (10.5 pt); it must not inherit body text size.
\AtBeginEnvironment{table}{\zihao{5}\songti}
\AtBeginEnvironment{longtable}{\zihao{5}\songti}

% Scale only tables that would otherwise exceed the text width.
\newsavebox{\fitwidetablebox}
\newcommand{\fitwidetable}[1]{%
  \sbox{\fitwidetablebox}{#1}%
  \ifdim\wd\fitwidetablebox>\textwidth
    \resizebox{\textwidth}{!}{#1}%
  \else
    #1%
  \fi
}

% Bibliography lines should not break inside English words. Existing hyphens
% remain valid break points.
\newcommand{\HUST@bibnohyphen}{%
  \hyphenpenalty=10000%
  \exhyphenpenalty=10000%
  \tolerance=2000%
  \emergencystretch=2em%
}
\makeatletter
\@ifundefined{AtBeginBibliography}{}{\AtBeginBibliography{\HUST@bibnohyphen}}
\@ifundefined{AtEveryBibitem}{}{\AtEveryBibitem{\HUST@bibnohyphen}}
\makeatother

%==================== 引用 ====================%
\newcommand{\sectionid}{}
\newcommand{\mlbl}[1]{\label{\sectionid-#1}}
\newcommand{\mref}[2][\sectionid]{\autoref{#1-#2}}

\makeatletter
\newcommand{\HUST@refglue}{\CJKecglue}
\providecommand{\figref}[1]{}
\providecommand{\tabref}[1]{}
\providecommand{\algref}[1]{}
\providecommand{\eqnref}[1]{}
\renewcommand{\figref}[1]{图\CJKecglue\ref{#1}\HUST@refglue}
\renewcommand{\tabref}[1]{表\CJKecglue\ref{#1}\HUST@refglue}
\renewcommand{\algref}[1]{算法\CJKecglue\ref{#1}\HUST@refglue}
\renewcommand{\eqnref}[1]{式\CJKecglue\ref{#1}\HUST@refglue}
\makeatother

%==================== 数学 ====================%
\newcommand{\Sufficiency}{\noindent\textit{充分性.\ \ }}
\newcommand{\Necessity}{\noindent\textit{必要性.\ \ }}

\newcommand{\Prob}[1]{\textsc{#1}}
\newcommand{\Cls}[1]{\textsf{#1}}

\newcommand{\e}{\mathrm{e}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\rarr}{\rightarrow}
\newcommand{\Rarr}{\Rightarrow}
\DeclareMathOperator{\poly}{poly}

\newfontfamily\HUSTCircleNumberFont{SimSun}
\newcommand{\circlednumber}[1]{%
  {\HUSTCircleNumberFont
  \ifcase#1\relax
  \or \symbol{"2460}\or \symbol{"2461}\or \symbol{"2462}\or \symbol{"2463}\or \symbol{"2464}%
  \or \symbol{"2465}\or \symbol{"2466}\or \symbol{"2467}\or \symbol{"2468}\or \symbol{"2469}%
  \else #1%
  \fi}%
}
